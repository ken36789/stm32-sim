{
  "name": "stm32-sim",
  "version": "0.7.1",
  "private": true,
  "description": "瀏覽器裡的 MCU 模擬實驗室：116 種晶片的 3D 接線、檢測、燒錄，與 I2C／UART／SPI／CAN 邏輯分析儀",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint src tests",
    "check": "npm run lint && npm test && npm run build",
    "build:single": "vite build && node scripts/build-single.mjs"
  },
  "dependencies": {
    "marked": "17.0.6",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.12.0",
    "vite": "5.4.21"
  },
  "engines": {
    "node": ">=18"
  }
}
